{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal capability: the main window may call DesignGrill's own commands only.",
  "windows": ["main"],
  "permissions": [
    "allow-session-list",
    "allow-session-load",
    "allow-session-save",
    "allow-session-delete",
    "allow-problem-upsert",
    "allow-preference-list",
    "allow-preference-set",
    "allow-credential-set",
    "allow-credential-status",
    "allow-credential-delete",
    "allow-ai-http-request",
    "allow-ai-cancel"
  ]
}
